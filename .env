# PostgreSQL
POSTGRES_USER=ams_user
POSTGRES_PASSWORD=ams_pass
POSTGRES_DB=audit_mgmt

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=audit-evidence

# Backend
API_PORT=4000
DATABASE_URL="postgresql://ams_user:ams_pass@localhost:5433/audit_mgmt"
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_COMPANY_NAME=Audit Management System

# Email / SMTP — used when an auditor allots users to an audit.
# Leave SMTP_HOST empty to capture every mail in apps/api/mail-outbox (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Envelope sender. Leave empty to send the mail from the auditor's own address.
MAIL_FROM=
MAIL_COMPANY_NAME=ChipTest Engineering Pvt. Ltd.
WEB_APP_URL=http://localhost:3000